  "root_cause": {
    "hypothesis": "Tree reduction has no __syncthreads() between halving rounds.",
    "mechanism": "Threads in different waves (block=256 spans 4 waves on DCU) read stale sdata values before writes from the previous stride are visible, yielding systematically low and non-deterministic sums.",
    "confidence": 0.92,
    "bug_type": "reduction_race",
    "affected_lines": [],
    "_source": "heuristic"
  },
  "patch_plan": {
    "summary": "Add __syncthreads() after the initial shared-mem load and at the top of each reduction round.",
    "diff": "  sdata[tid] = ...;\n+ __syncthreads();\n  for (int stride = ...; ...) {\n+   __syncthreads();\n    if (tid < stride) sdata[tid] += sdata[tid+stride];\n  }",
    "risks": [
      "Heuristic template \u2014 verify with recompile/rerun"
    ],
    "expected_effect": "STATUS: PASS with sum == N for every run; RUN_SPREAD delta = 0.",
    "validation_steps": [
      "rerun 5 times and confirm identical sums"
    ]
  },
